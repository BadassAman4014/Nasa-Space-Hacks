# FieldShift AI - NASA Earthdata Authentication Configuration (Optional)
# A free NASA Earthdata account can be created at https://urs.earthdata.nasa.gov/
# When set, direct real-time downloads from NASA DAACs (NSIDC for SMAP, GES DISC for GPM, LP DAAC for MODIS)
# will be authenticated automatically.
# If not set, FieldShift AI utilizes open NASA Earth observation APIs and pre-cached Brandenburg granules.

EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Or Bearer token:
EARTHDATA_TOKEN=

# API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

